# Copy to .env.local, or run `npm run setup` to generate one with random secrets.
# Never commit real secrets.

# ── Secrets (required) ────────────────────────────────────────────────
SESSION_SECRET=            # HMAC key for hashing session tokens (any long random string)
DATA_ENCRYPTION_KEY=       # 64 hex chars (32 bytes) AES-256 key; BACK IT UP: losing it makes evidence unreadable
AUDIT_HMAC_KEY=            # HMAC key that seals the audit-log hash chain

# ── Organisation (compiled into the UI at build time) ─────────────────
NEXT_PUBLIC_ORG_NAME="Demo Organization"
NEXT_PUBLIC_APP_TIMEZONE=Africa/Lagos

# ── Database ──────────────────────────────────────────────────────────
# Local / Docker: a SQLite file (default data/cirp.db). Evidence is stored, encrypted, in the database.
# DATABASE_PATH=data/cirp.db
# Hosted (required on Vercel): Turso. The Vercel–Turso integration sets these two automatically.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# Vercel Cron authentication for /api/cron/sla (Vercel sends it automatically)
# CRON_SECRET=

# ── Security policy ───────────────────────────────────────────────────
# SECURE_COOKIES=true               # default true in production; set false only for plain-HTTP demos
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=8
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# AUTH_RATE_LIMIT=20                # sign-in attempts per IP per 15 minutes
# REQUIRE_MFA_FOR_PRIVILEGED=false  # true = analysts, managers, admins and auditors must enrol in MFA
# ALLOW_SELF_REGISTRATION=true
# ALLOWED_EMAIL_DOMAINS=example.org,example.com

# ── Compliance ────────────────────────────────────────────────────────
# BREACH_NOTIFICATION_HOURS=72
# REGULATOR_NAME="Nigeria Data Protection Commission (NDPC)"

# ── Demo ──────────────────────────────────────────────────────────────
# SHOW_DEMO_ACCOUNTS=false          # show demo credentials on the sign-in page
